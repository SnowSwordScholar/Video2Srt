{
  "src_root": "",
  "dst_root": "output",
  "model_preset": "large-v3",
  "model_base": "models/large-v3",
  "log_file": "progress.log",
  "cloud_failed": "cloud_failed.txt",
  "cache_dir": ".cache/videos",
  "video_extensions": [
    ".mp4",
    ".mkv",
    ".mov",
    ".m4a",
    ".mp3",
    ".wav"
  ],
  "preserve_source_root_name": true,
  "use_local_cache": true,
  "delete_cache_after": true,
  "device": "auto",
  "compute_type": "default",
  "language": "zh",
  "task": "transcribe",
  "beam_size": 5,
  "temperature": 0.0,
  "condition_on_previous_text": false,
  "compression_ratio_threshold": 2.4,
  "log_prob_threshold": -1.0,
  "no_speech_threshold": 0.6,
  "hallucination_silence_threshold": 1.0,
  "initial_prompt": "以下是普通话的句子。",
  "vad_min_silence_duration_ms": 420,
  "vad_speech_pad_ms": 200,
  "max_sentence_duration": 4.8,
  "max_chars_per_line": 18,
  "max_chars_per_sentence": 28,
  "gap_threshold": 0.45,
  "min_caption_duration": 0.35,
  "min_caption_gap": 0.01,
  "retry_wait": 60,
  "retry_times": 10,
  "io_retry": 3,
  "io_retry_delay": 30
}
